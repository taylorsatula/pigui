# picloud's Docker configuration: copy this file to .env and fill it in. docker compose reads .env; never commit it.

# A Tailscale auth key (admin console: Settings, Keys). It is used once to join your tailnet and can be removed after.
# Leave it empty to log in from the link that `docker compose logs tailscale` prints instead.
TS_AUTHKEY=

# Two GitHub fine-grained tokens, both for the repositories picloud may use.
# picloud's own, with Contents and Pull requests read and write, and Metadata read. picloud lists, clones, pushes and
# opens pull requests with it, and only when you tap; agent commands never see it.
GH_TOKEN=
# The agent's, read-only: Contents read and Metadata read. Its commands' gh and git use it, so nothing they run can
# change anything on GitHub.
AGENT_GH_TOKEN=

# Optional.
# The machine's name in your tailnet: picloud is served at https://<name>.<tailnet>.ts.net
PICLOUD_TS_HOSTNAME=picloud
# A mailto: or https: contact that push services may use to reach whoever runs this server.
PICLOUD_PUSH_SUBJECT=mailto:picloud@localhost
# Comma-separated Tailscale logins allowed in; empty allows everyone on your tailnet.
PICLOUD_ALLOWED_LOGINS=
# Default per-session spend cap in US dollars; empty for none.
PICLOUD_SPEND_CAP=
# The model that writes compaction checkpoints, as Pi names it (provider/modelId); empty for each session's own model.
PICLOUD_COMPACTION_MODEL=
# Long-term memory across sessions is on when the image embeds on this machine (PICLOUD_MEMORY_LOCAL below) or Pi holds a
# key for this provider (in its auth.json, or the provider in its models.json); otherwise it is off, and the sidebar
# says so. The Pi provider whose key signs embedding requests:
PICLOUD_MEMORY_PROVIDER=lunaroute
# The embedding model; memory's search thresholds are tuned for emb-qwen3.
PICLOUD_MEMORY_EMBED_MODEL=emb-qwen3
# An OpenAI-compatible embeddings URL; empty for the provider's base URL in Pi's catalog plus /embeddings (for lunaroute
# without one, https://gw.lunaroute.com/v1/embeddings). Set, it is used even in an image that embeds locally.
PICLOUD_MEMORY_EMBED_URL=
# on confines every agent command with Landlock, from the host's kernel; off runs them unconfined, for a host whose
# kernel has no Landlock.
PICLOUD_SANDBOX=on
# on reads replies aloud with Kokoro, a speech model that runs on this machine's CPU: it adds about 550 MB to the image
# and uses about 650 MB of memory while reading, most of it given back after five idle minutes. off leaves it out of
# the image. Applies at `docker compose build`.
PICLOUD_SPEECH=on
# on embeds long-term memory on this machine's CPU with LEAF (mdbr-leaf-ir-asym), with no key and no network, instead
# of with the provider above: it adds about 135 MB of models to the image (and the 460 MB of packages that run them, if
# speech is off) and uses about 300 MB of memory while embedding, given back after five idle minutes. Applies at
# `docker compose build`.
PICLOUD_MEMORY_LOCAL=off
