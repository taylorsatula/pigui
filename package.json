{
	"name": "pigui",
	"version": "1.0.0",
	"private": true,
	"description": "A self-hosted harness for driving the Pi coding agent from a phone.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
		"typecheck": "tsc -p tsconfig.json",
		"start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
		"fake": "node --disable-warning=ExperimentalWarning scripts/fake.ts",
		"pretest": "node --disable-warning=ExperimentalWarning scripts/check-install.ts",
		"test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=4 \"test/**/*.test.ts\"",
		"test:browser": "playwright test --trace off",
		"check": "npm run typecheck && npm run build && npm test && npm run test:browser"
	},
	"dependencies": {
		"@earendil-works/chord": "1.6.0",
		"@earendil-works/pi-ai": "1.6.0",
		"@earendil-works/pi-coding-agent": "1.6.0",
		"@earendil-works/pi-durable": "1.6.0",
		"@earendil-works/pi-schema": "1.6.0",
		"escape-html": "1.0.3",
		"idiomorph": "0.8.0",
		"marked": "18.1.2",
		"sanitize-html": "2.18.2"
	},
	"devDependencies": {
		"@fontsource-variable/ibm-plex-sans": "5.3.0",
		"@fontsource-variable/source-serif-4": "5.3.1",
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@playwright/test": "1.63.0",
		"@types/escape-html": "1.0.4",
		"@types/node": "22.20.5",
		"@types/sanitize-html": "2.16.2",
		"typescript": "6.0.3"
	},
	"optionalDependencies": {
		"@huggingface/transformers": "3.8.1",
		"kokoro-js": "1.2.1"
	}
}
